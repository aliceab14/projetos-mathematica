Cell[BoxData[
 RowBox[{
  RowBox[{"wbar", "[", 
   RowBox[{"p_", ",", "w11_", ",", "w12_", ",", "w22_"}], "]"}], ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"p", "^", "2"}], ")"}], "w11"}], " ", "+", " ", 
   RowBox[{"2", "p", 
    RowBox[{"(", 
     RowBox[{"1", "-", "p"}], ")"}], "w12"}], " ", "+", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "p"}], ")"}], "^", "2"}], ")"}], 
    "w22"}]}]}]], "Input",
 CellChangeTimes->{{4.00212202179228*^9, 4.002122149635643*^9}},
 CellLabel->
  "In[616]:=",ExpressionUUID->"aa8d5ac7-5e5e-2f4d-bba8-6bd11d2093ef"],

