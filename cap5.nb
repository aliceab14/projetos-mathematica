   RowBox[{
   "c_", ",", "wbar_", ",", "Ne_", ",", "p_", ",", "u1_", ",", "u2_", ",", 
    "m_", ",", "p1_"}], "]"}], ":=", 
  RowBox[{"c", "*", 
