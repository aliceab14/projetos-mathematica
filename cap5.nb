Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]", "[", 
   RowBox[{"p_", ",", "Ne_", ",", "s_", ",", "u1_", ",", "u2_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"E", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "2"}], "*", "Ne", "*", "s", "*", 
       RowBox[{"(", 
        RowBox[{"p", "^", "2"}], ")"}]}], ")"}]}], ")"}], "*", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "p"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", "*", "Ne", "*", "u1"}], ")"}], "-", "1"}], ")"}]}], 
    ")"}], "*", 
   RowBox[{"(", 
    RowBox[{"p", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", "*", "Ne", "*", "u2"}], ")"}], "-", "1"}], ")"}]}], 
    ")"}]}]}]], "Input",
 CellChangeTimes->{{4.002137814462969*^9, 4.002137913436409*^9}, {
   4.002138083555031*^9, 4.0021381516136055`*^9}, 4.002138294948744*^9},
 CellLabel->"In[87]:=",ExpressionUUID->"cd2c127c-806c-3a40-953f-c65e8c62597a"],

