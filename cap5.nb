Cell[BoxData[
 RowBox[{
  RowBox[{"wbar3", "[", 
   RowBox[{"p_", ",", "s_"}], "]"}], ":=", " ", 
  RowBox[{"E", "^", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "s"}], "*", 
     RowBox[{"p", "^", "2"}]}], ")"}]}]}]], "Input",
