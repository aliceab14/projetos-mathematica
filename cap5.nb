Cell["Kolmogorov backward : equilibrium distribution", "Text",
 CellChangeTimes->{{4.0022047327125626`*^9, 4.0022047415771065`*^9}, {
  4.0022222082134113`*^9, 
  4.0022222238272324`*^9}},ExpressionUUID->"7355f95f-ce52-e846-8b1a-\
8ce880cdf650"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wbar", "[", 
   RowBox[{"p_", ",", "w11_", ",", "w12_", ",", "w22_"}], "]"}], ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"p", "^", "2"}], ")"}], "w11"}], " ", "+", " ", 
   RowBox[{"2", "p", 
    RowBox[{"(", 
     RowBox[{"1", "-", "p"}], ")"}], "w12"}], " ", "+", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "p"}], ")"}], "^", "2"}], ")"}], 
    "w22"}]}]}]], "Input",
 CellLabel->
  "In[682]:=",ExpressionUUID->"59e29e9e-2b44-6d40-9908-48eaf1010a8b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"backward", "=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"F", "[", "p0", "]"}], ",", "p0"}], "]"}], "==", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"2", "*", 
        RowBox[{
         RowBox[{"M", "[", "p0", "]"}], "/", 
         RowBox[{"V", "[", "p0", "]"}]}]}], ")"}]}], "*", 
     RowBox[{"F", "[", "p0", "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{4.002222240654337*^9, 4.0022222790519257`*^9}, {
  4.0022223253102036`*^9, 4.0022223788573933`*^9}, {4.00222248053899*^9, 
  4.002222483583109*^9}, {4.0022225554777374`*^9, 4.002222697492388*^9}, {
  4.0022227573616104`*^9, 4.002222761323103*^9}, {4.002222793112673*^9, 
  4.0022227997668285`*^9}, {4.0022231023825817`*^9, 4.0022231231965675`*^9}},
 CellLabel->
  "In[683]:=",ExpressionUUID->"ae8c4a66-b404-aa43-b8f5-f9b648ef18e7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sol", "=", 
  RowBox[{
   RowBox[{"DSolve", "[", 
    RowBox[{"backward", ",", 
     RowBox[{"F", "[", "p0", "]"}], ",", "p0"}], "]"}], "//", 
   "FullSimplify"}]}]], "Input",
 CellChangeTimes->{{4.002222399817379*^9, 4.0022224068606987`*^9}, {
  4.002222708138338*^9, 4.002222740129057*^9}, {4.0022229790039043`*^9, 
