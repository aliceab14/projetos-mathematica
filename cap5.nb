Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]", "[", 
   RowBox[{"p_", ",", "Nes_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"E", "^", 
    RowBox[{"(", 
     RowBox[{"4", "Nes", "*", "p"}], ")"}]}], "/", 
   RowBox[{"(", 
    RowBox[{"p", 
     RowBox[{"(", 
