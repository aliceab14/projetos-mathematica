Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]", "[", 
   RowBox[{
   "c_", ",", "wbar_", ",", "Ne_", ",", "p_", ",", "u1_", ",", "u2_"}], "]"}],
   ":=", 
  RowBox[{"c", "*", 
   RowBox[{"(", 
    RowBox[{"wbar", "^", 
     RowBox[{"(", 
      RowBox[{"2", "Ne"}], ")"}]}], ")"}], "*", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "p"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", "Ne", "*", "u1"}], ")"}], "-", "1"}], ")"}]}], ")"}], "*", 
   RowBox[{"(", 
    RowBox[{"p", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", "Ne", "*", "u2"}], ")"}], "-", "1"}], ")"}]}], 
    ")"}]}]}]], "Input",
