Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]mos", "[", 
   RowBox[{"p_", ",", "Nes_", ",", "Nem_"}], "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"E", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", "Nes", "*", "p"}], " ", ")"}], "+", 
       RowBox[{"(", 
        RowBox[{"4", "Nem", "*", 
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", "p"}], "]"}]}], ")"}]}], ")"}]}], "/", 
    RowBox[{"(", 
     RowBox[{"p", 
      RowBox[{"(", 
       RowBox[{"1", "-", "p"}], ")"}]}], ")"}]}], ")"}]}]], "Input",
 CellChangeTimes->{{4.002204757928276*^9, 4.0022049270402145`*^9}},
 CellLabel->
  "In[673]:=",ExpressionUUID->"69aa687e-5373-6145-89f4-39bee00eb26a"],

