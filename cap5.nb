   4.0021209632919636`*^9, {4.0021210004165897`*^9, 4.0021210926703224`*^9}, {
   4.0021218326018295`*^9, 4.0021218590953655`*^9}, 4.0021983896580105`*^9, {
   4.002198430621603*^9, 4.0021984443624134`*^9}, {4.002201148488964*^9, 
   4.0022011496165924`*^9}},ExpressionUUID->"e5d345c6-65fd-c64e-8d41-\
70fe930ba273"],

Cell["Kolmogorov forward: equilibrium distribution", "Text",
 CellChangeTimes->{{4.002204166667986*^9, 
  4.0022042118394394`*^9}},ExpressionUUID->"1e614bf1-cb15-da44-a578-\
3a542ef38d34"],

Cell[BoxData[
 RowBox[{"ClearAll", "[", 
  RowBox[{
  "M", ",", "V", ",", "psi", ",", "wbar", ",", "p", ",", "Ne", ",", "u1", ",",
    "u2"}], "]"}]], "Input",
 CellChangeTimes->{{4.002262576766796*^9, 4.0022625812453957`*^9}, {
   4.0022710176789913`*^9, 4.0022710347097626`*^9}, 4.0022710681008644`*^9, 
   4.0022712194141445`*^9},
 CellLabel->
  "In[601]:=",ExpressionUUID->"e55e0bb0-996a-b84b-8272-0ca08dfbec5b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"M", "[", "p_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"p", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "p"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", 
          RowBox[{"wbar", "[", "p", "]"}]}], ")"}]}]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"wbar", "[", "p", "]"}], ",", "p"}], "]"}], ")"}]}], "-", 
    RowBox[{"u1", "*", "p"}], "+", 
    RowBox[{"u2", 
     RowBox[{"(", 
      RowBox[{"1", "-", "p"}], ")"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{4.0022025854767265`*^9, 4.0022026083468266`*^9}, {
   4.002202750739292*^9, 4.0022027540461655`*^9}, 4.0022028646532707`*^9, 
   4.0022030313725224`*^9, {4.002203886008999*^9, 4.002203895801777*^9}, {
   4.0022630798422184`*^9, 4.002263086634449*^9}, 4.002263242016577*^9, {
   4.002263341495579*^9, 4.0022633608410053`*^9}, {4.002263475537674*^9, 
   4.002263499850685*^9}, {4.002263532899227*^9, 4.0022635340594654`*^9}, {
   4.00226386310182*^9, 4.0022638640329227`*^9}, {4.002270989851946*^9, 
   4.002270993461445*^9}, {4.002271091893961*^9, 4.0022710922000294`*^9}, {
   4.0022712440567436`*^9, 4.0022712708998127`*^9}},
 CellLabel->
  "In[602]:=",ExpressionUUID->"220df55b-f2fa-a746-a478-1dc9914f075a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"V", "[", "p_", "]"}], ":=", 
   RowBox[{"p", "*", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "p"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "Ne"}], ")"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{4.0022026115652943`*^9, 4.002202619727703*^9}, {
   4.0022027481540737`*^9, 4.0022027485115356`*^9}, 4.0022028752645283`*^9, {
   4.0022029340921*^9, 4.0022029344554863`*^9}},
 CellLabel->
  "In[603]:=",ExpressionUUID->"dceeae9b-dd0c-f447-9a88-e27844d5855c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"forward", "=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"V", "[", "p", "]"}], "*", 
       RowBox[{"psi", "[", "p", "]"}]}], ",", "p"}], "]"}], "==", 
    RowBox[{"2", "*", 
     RowBox[{"M", "[", "p", "]"}], "*", 
     RowBox[{"psi", "[", "p", "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{4.00220295161331*^9, 4.0022029776587524`*^9}, {
  4.002263510160818*^9, 4.0022635111005497`*^9}, {4.0022712985391846`*^9, 
  4.0022712992626743`*^9}},
 CellLabel->
  "In[604]:=",ExpressionUUID->"1d1a8520-e1bc-4e49-b3e8-18e9346b8ab4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sol", "=", 
  RowBox[{
   RowBox[{"DSolve", "[", 
    RowBox[{"forward", ",", 
     RowBox[{"psi", "[", "p", "]"}], ",", "p"}], "]"}], "//", 
   "FullSimplify"}]}]], "Input",
 CellChangeTimes->{{4.002202987445631*^9, 4.0022030018242683`*^9}, {
  4.002203922506031*^9, 4.0022039263629704`*^9}},
 CellLabel->
  "In[605]:=",ExpressionUUID->"f8eccb27-4180-db4e-872e-0a01bf1a7c1b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"psi", "[", "p", "]"}], "\[Rule]", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", "p"}], ")"}], 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       RowBox[{"4", " ", "Ne", " ", "u1"}]}]], " ", 
     SuperscriptBox["p", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       RowBox[{"4", " ", "Ne", " ", "u2"}]}]], " ", 
     TemplateBox[{"1"},
      "C"], " ", 
     SuperscriptBox[
      RowBox[{"wbar", "[", "p", "]"}], 
      RowBox[{"2", " ", "Ne"}]]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{4.0022029933848896`*^9, 4.0022030048612614`*^9}, 
   4.002203037956171*^9, {4.0022039044205627`*^9, 4.0022039273840103`*^9}, 
   4.002205538902069*^9, 4.0022056416300297`*^9, 4.0022635404337482`*^9, 
   4.0022713043248425`*^9},
 CellLabel->
  "Out[605]=",ExpressionUUID->"d5957429-470e-4d44-b915-8800f667fd3b"]
}, Open  ]],

Cell["mutation and drift:", "Text",
