 CellLabel->
  "In[652]:=",ExpressionUUID->"d04e6ecd-c707-2246-b458-de488dc696fc"],

Cell[BoxData[
 RowBox[{"c", " ", 
  SuperscriptBox[
   RowBox[{"(", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["p", "2"]}], " ", "s"}]], ")"}], 
   RowBox[{"2", " ", "Ne"}]], " ", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"1", "-", "p"}], ")"}], 
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    RowBox[{"4", " ", "Ne", " ", "u1"}]}]], " ", 
  SuperscriptBox["p", 
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    RowBox[{"4", " ", "Ne", " ", "u2"}]}]]}]], "Output",
