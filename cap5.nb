 RowBox[{"\[Psi]", "[", 
  RowBox[{"c", ",", 
   RowBox[{"wbar3", "[", 
    RowBox[{"p", ",", "s"}], "]"}], ",", "Ne", ",", "p", ",", "u1", ",", 
   "u2"}], "]"}]], "Input",
