  "In[684]:=",ExpressionUUID->"e7ea644f-4f01-c349-9da3-ad68a6375695"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"F", "[", "p0", "]"}], "\[Rule]", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      TemplateBox[{
        RowBox[{"-", 
          FractionBox[
           RowBox[{"2", " ", 
             RowBox[{"M", "[", 
               RowBox[{"K", "[", "1", "]"}], "]"}]}], 
           RowBox[{"V", "[", 
             RowBox[{"K", "[", "1", "]"}], "]"}]]}], 
        RowBox[{"K", "[", "1", "]"}], "1", "p0"},
       "InactiveIntegrate",
       DisplayFunction->(RowBox[{
          SubsuperscriptBox[
           StyleBox["\[Integral]", "Inactive"], #3, #4], 
          RowBox[{#, 
            RowBox[{
              StyleBox["\[DifferentialD]", "Inactive"], #2}]}]}]& ),
       InterpretationFunction->(RowBox[{
          RowBox[{"Inactive", "[", "Integrate", "]"}], "[", 
          RowBox[{#, ",", 
            RowBox[{"{", 
              RowBox[{#2, ",", #3, ",", #4}], "}"}]}], "]"}]& )]], " ", 
     TemplateBox[{"1"},
      "C"]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{4.002223065408806*^9, 4.002223128912668*^9}, 
   4.0022718660303593`*^9, 4.00227190970706*^9},
 CellLabel->
  "Out[684]=",ExpressionUUID->"708ae67f-1652-d243-9c4c-914a91e1955b"]
}, Open  ]],

